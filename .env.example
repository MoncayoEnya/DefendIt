# Copy this file to ".env" for running on your computer (npm run dev).
# On Vercel, add the same names under Project > Settings > Environment Variables.
# .env is in .gitignore, so your keys never go to GitHub.

# ---- AI (server side, kept secret) ----
# Add at least one. Both is best: Groq is fast for short tasks, Gemini handles whole theses.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional settings:
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# AI_LIMIT_PER_HOUR=60

# ---- Accounts, cloud saving, leaderboard (optional, see docs/CLOUD_SETUP.md) ----
# These two are public by design (VITE_ means the browser can see them).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Android app build only ----
# Your live site, so the app can reach the AI. Example: https://defendit.vercel.app
VITE_API_BASE=
